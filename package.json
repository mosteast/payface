{
  "name": "payface",
  "version": "0.8.1",
  "description": "TypeScript payment SDK for Alipay, Wechat Pay v3, and Stripe",
  "homepage": "https://github.com/mosteast/payface#readme",
  "repository": "github:mosteast/payface",
  "license": "ISC",
  "author": "Mosteast team",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build/"
  ],
  "scripts": {
    "build": "./bin/build",
    "coverage": "NODE_ENV=test vitest run --coverage",
    "format": "npx sort-package-json && npx prettier --write .",
    "go": "npm run release",
    "pack:check": "npm run build && cd build && rm -f ./*.tgz && npm pack --json > /dev/null && rm -f ./*.tgz",
    "release": "npm run build && cd build && npm publish --access public",
    "test": "NODE_ENV=test vitest",
    "test:integration": "PAYFACE_RUN_INTEGRATION=1 NODE_ENV=test vitest run src/alipay.integration.test.ts src/tenpay.integration.test.ts",
    "test:run": "NODE_ENV=test vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mosteast/common_eid": "^0.2.0",
    "@mosteast/e": "^0.2.2",
    "alipay-sdk": "^3.6.1",
    "date-fns": "^3.3.1",
    "debug": "^4.3.4",
    "decimal.js": "^10.4.3",
    "nanoid": "^3.3.7",
    "stripe": "^20.4.0",
    "wechatpay-node-v3": "^2.2.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.11.17",
    "@types/shelljs": "^0.8.15",
    "@vitest/coverage-v8": "1.2.2",
    "dotenv": "^16.4.4",
    "fs-extra": "^11.2.0",
    "lodash": "^4.17.21",
    "shelljs": "^0.8.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "utility-types": "^3.11.0",
    "vitest": "^1.2.2"
  }
}
