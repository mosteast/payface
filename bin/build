#!/usr/bin/env node

const { dir_root } = require('../root')
const { writeFileSync, pathExistsSync, ensureDirSync, copySync } = require('fs-extra')
const { mv, exec, mkdir } = require('shelljs')

const r = dir_root

run()

async function run() {
  prepare_environment()
  backup_git()
  compile()
  copy_requirements()
  edit_config()
}

function prepare_environment() {
  process.env.NODE_ENV = 'production'
}

function compile() {
  ensureDirSync(b())
  exec(`rm -fr ${b('*')}`)
  exec(`npx tsc`)
}

function copy_requirements() {
  copySync(r('readme.md'), b('readme.md'))
  if (pathExistsSync(r('CHANGELOG.md'))) {
    copySync(r('CHANGELOG.md'), b('CHANGELOG.md'))
  }
}

function edit_config() {
  const src = require(r('./package.json'))
  const json = {
    name: src.name,
    version: src.version,
    description: src.description,
    homepage: src.homepage,
    repository: src.repository,
    license: src.license,
    author: src.author,
    main: 'index.js',
    types: 'index.d.ts',
    files: ['index.js', 'index.d.ts', 'src/', 'readme.md', 'CHANGELOG.md'],
    exports: {
      '.': {
        import: './index.js',
        require: './index.js',
        types: './index.d.ts',
      },
    },
    dependencies: src.dependencies,
  }
  writeFileSync(dir_root('build/package.json'), JSON.stringify(json, null, 2) + '\n')
}

function backup_git() {
  const tmp_path = r('tmp')
  const git_path = b('.git')
  const git_backup_path = `${tmp_path}/.git_tmp_backup`

  if (pathExistsSync(git_path)) {
    mkdir('-p', tmp_path)
    mv(git_path, git_backup_path)
    mv(git_backup_path, git_path)
    copySync(r('.gitignore'), b('.gitignore'))
  }
}

/**
 * dir_build
 * @param args
 * @returns {string}
 */
function b(...args) {
  return r('build', ...args)
}
